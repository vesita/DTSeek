flowchart TD
  subgraph input["输入层"]
    raw_text["任意输入文本<br/>意图：接收长短不一的自然语言（聊天/文档/长段落）<br/>原理：输入形态不做任何假设，也不需要用户预先分句"]
    segmenter["自适应分句引擎<br/>意图：让每个片段的长度落在小模型最敏锐的窗口内<br/>原理：按标点断句，过长再按逗号二级切分；切分时记录全局绝对坐标，子句预测可无损还原到整篇"]
    doc_tok["字级分词器 (8192项)<br/>意图：任意中文一字一 token，无 BPE 碎片<br/>原理：ASCII 直通区 id==ord(c) + 系统词区 + 高频汉字区，三区对齐 2 的整数幂"]
  end
  subgraph base["共享基座 (NanoDocEncoder)"]
    doc_encoder["高效双向文本编码器<br/>意图：一次前向抽取出可被多任务反复查询的语义场<br/>原理：移植 nanoSeek 实测资产 RMSNorm + RoPE + QK-Norm + SwiGLU + Flash-SDPA；长序列显存约为朴素实现的 45%"]
    doc_memory["文本记忆特征图 [B, L, D]<br/>意图：同一份文本的特征只算一次，供所有任务卡共享<br/>原理：padding 隔离经不变量测试保证逐位不变，打乱补齐区不改变有效区输出"]
  end
  subgraph task["动态任务卡 (可插拔)"]
    task_spec["类别体系定义<br/>意图：换任务只换类别语义，不动基座<br/>原理：每个任务一份「类别集合 + 各任务独立解码头」，彼此不共享参数"]
    task_cards["任务卡注册表｜意图：代词 / 情绪 / 发言归属 / 词义关系各持一张，共享同一基座｜原理：加一个任务 = 在 tasks/builtin/ 下加一个文件夹（spec + 数据集 + 探针），训练脚本与示例一行都不用改"]
    query_proj["起始 Query (BOS)<br/>意图：给「开始吐第一个切片」一个统一的起点<br/>原理：可学习向量，与回填的切片状态串联成解码序列"]
  end
  subgraph emit["自回归切片发射 (核心)"]
    decoder["因果掩码交叉解码<br/>意图：每步只专注吐「下一个切片」<br/>原理：Query 走因果自注意力（不看未来步）+ 交叉注意力查询文本记忆"]
    start_end_ptr["双指针定位头<br/>意图：直接指向原文的起止字符，不回归边界框<br/>原理：Query 与文本记忆做点积，argmax 得到 1-based 闭区间 [start, end]"]
    action_head["动作头：继续 / 收束<br/>意图：让模型自己决定还有没有下一个切片 原理：不预设切片上限；吐「继续」就再发射一个切片，吐「收束」就停下，天然支持 0 到任意多个"]
    feedback_proj["切片状态回填<br/>意图：让下一步知道「我刚圈了哪个词、在哪」<br/>原理：把上一步隐状态 + 类别嵌入 + 归一化位置融合投影，作为下一步输入"]
    mention_ndb[("情节提及记忆 (NDB)｜意图：让身份槽任务记住「这篇里这个字面刚被指成谁」｜原理：键=提及起始处 1~2 字 n-gram，值=此前分配的身份槽 id；逐样本建空表，只回写模型自己发射过的切片（绝不写真值）；读权重必须离散——软读会把新人物判成已覆盖｜实测：person 重复提及正确率 0.375→0.843（3 seed Δ=+0.469，极差 0.011）；代价 +27.7% 步时（已从 +34.7% 优化，指标逐位不变；门控 backward 单项即 8%，是删不掉的地板）/ +264 参数 / +30MB｜已否证：参数化记忆与可学习 n-gram 表（旁路消融为空壳，全局确定性 key→id 表的贝叶斯上界仅 0.347，低于不做记忆的 base）——关键是「寻址离散」，不是「表参不参数化」")]
  end
  subgraph output["输出与呈现"]
    final_output["结构化锚点<br/>意图：对外只给坐标与类别，不生成任何原文<br/>原理：模型零文本输出 ⇒ 零幻觉；锚点为 1-based 闭区间 + 类别 + 置信度"]
    renderer["原文高亮渲染<br/>意图：把数字锚点变成人一眼能看懂的东西<br/>原理：按锚点索引在原文上着色，跨任务用不同色系区分，未命中的文字保持原样"]
  end
  subgraph traineval["训练与验收闭环"]
    multitask_train["多任务交替联合训练｜意图：基座与各任务卡同步进化｜原理：每步轮换消费各任务 batch；基座小 lr 稳、任务头大 lr 快，余弦退火｜帧数与样本量必须够，否则模型背句式而不是学任务"]
    word_probe["换帧词级探针｜意图：回答「有没有整项没学会」，以及「是学会了任务还是学会了句式」｜原理：把每个词/词对放进与训练不重合的载体句逐个测；自带已知答案对照，并分开报类别错与定位错"]
    fail_closed["数据集 fail-closed 校验｜意图：标签污染在构建时就炸掉，而不是静默训坏｜原理：载体模板、背景句池一旦混入未标注的正例就抛错或丢弃样本（实际抓到「也没用」「支持」两处，以及成对任务的「另一对完整词」）"]
  end
  raw_text --> segmenter
  segmenter --> doc_tok
  doc_tok --> doc_encoder
  doc_encoder --> doc_memory
  task_spec --> task_cards
  task_cards --> decoder
  query_proj --> decoder
  doc_memory --> decoder
  decoder --> start_end_ptr
  decoder --> action_head
  start_end_ptr --> final_output
  action_head -->|"还有下一个"| feedback_proj
  feedback_proj --> decoder
  action_head -->|"收束"| final_output
  final_output --> renderer
  multitask_train --> doc_encoder
  multitask_train --> task_cards
  word_probe --> final_output
  fail_closed --> task_spec
  decoder -.->|"读：按预测起点检索"| mention_ndb
  feedback_proj -.->|"写：已发射切片"| mention_ndb
  mention_ndb -.->|"身份槽类别 logits"| final_output
