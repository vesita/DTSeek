# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 模型权重与训练产物（体积大、可复现，不入 git）
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# 训练中间产物
out/
logs/
*.log

# 其他常见模型权重格式
*.bin
*.gguf
*.msgpack
*.h5
*.pb
*.tflite

# 发布暂存目录（权重不进 git）
release/

# 实验派生缓存：数据集转储，可由脚本重建（体积大）
experiments/**/person_val_seed*.json
